# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，切勿提交。

# —— LLM（OpenAI 兼容协议，示例用阿里云百炼 DashScope）——
LLM_MODEL=deepseek-v4.1-flash
OPENAI_API_KEY=your-api-key
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# —— 向量检索（Embedding 服务，示例用 SiliconFlow）——
KNOWLEDGE_DB_PATH="rag/faiss"
CHUNK_SIZE=500
CHUNK_OVERLAP=80
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DIM=1024
SILICON_API_KEY="your-api-key"
SILICON_API_BASE="https://api.siliconflow.cn/v1"

# —— 联网调研（MCP，可选）——
# 不配置则自动跳过联网调研，不影响主流程
TAVILY_API_KEY=your-tavily-key
TAVILY_MCP_URL=https://mcp.tavily.com/mcp

# —— 运行参数 ——
# RAG_ENABLED=0            # 关闭 RAG（默认开启）
# MAX_FIX_ATTEMPTS=3       # 修复重试上限
# VERIFY_TIMEOUT=5         # 执行验证超时（秒）
# RAG_MAX_DISTANCE=0.9     # 检索结果的最大 L2 距离
# MCP_CONFIDENCE_THRESHOLD=0.7   # 检测置信度低于此值时升级到联网调研
# KNOWLEDGE_SOURCE=rag/bug_fix_corpus.txt   # 重建索引时的语料来源
